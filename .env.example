# Set NODE_ENV=production in the production host environment.
PORT=3001
DATABASE_URL=postgresql://oslc:change-me@localhost:5432/oslc
DATABASE_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_URL=https://oslcwebsite.vercel.app
# Optional exact LAN origins for development, comma-separated.
DEV_ALLOWED_ORIGINS=
UPLOAD_DIR=./uploads
TRUST_PROXY=0
# Configure all SMTP settings to enable notifications; otherwise enquiries are stored only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_NOTIFY_TO=

# Recruitment: private PDF resumes are stored in PostgreSQL, not UPLOAD_DIR.
RESUME_MAX_MB=5
RECRUITMENT_RETENTION_DAYS=180
# Optional company-approved text; otherwise a notice using the configured retention period is shown.
RECRUITMENT_PRIVACY_NOTICE=
# Uses the common SMTP_* settings. Nothing is emailed unless the relevant option is configured.
RECRUITMENT_NOTIFY_TO=
RECRUITMENT_ACKNOWLEDGEMENTS=false
RECRUITMENT_STATUS_EMAILS=false
