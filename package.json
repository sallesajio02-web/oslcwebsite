{
  "name": "oslc-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "editor": "vite --host 127.0.0.1 --open /editor",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "migrate": "tsx server/manage.ts migrate",
    "careers:purge": "tsx server/manage.ts careers-purge",
    "admin:create": "tsx server/manage.ts admin",
    "seed:demo": "tsx server/manage.ts seed",
    "uploads:import": "tsx server/manage.ts import-uploads",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:editor": "node scripts/test-editor-browser.mjs && node scripts/test-editor-interactions.mjs",
    "db:local": "node scripts/local-db.mjs",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --packages=external --format=esm --outfile=api/index.js",
    "build:vercel": "tsc --noEmit && vite build && npm run build:api"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@tailwindcss/vite": "^4.1.0",
    "bcryptjs": "^3.0.2",
    "codemirror": "^6.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.2",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.0",
    "parse5": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sharp": "^0.35.5",
    "swiper": "^14.3.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
